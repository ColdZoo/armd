{
  "name": "armd",
  "version": "0.1.0",
  "updated": "2026-11-22",
  "summary": "Dynamixel 机械臂串口守护进程：独占串口总线，对上层提供 NDJSON RPC 与发布订阅；持有标定档案（profile）。",
  "transport": {
    "unix": "/tmp/armd.sock（macOS/Linux 本机；权限 0600）",
    "tcp": "tcp://host:8771（下位机/网络场景，配置 listen 里开启）",
    "framing": "NDJSON：一行一个 JSON。请求/响应用 id 配对；推送帧带 event 字段、无 id。",
    "auth": "配置 token 后，客户端必须先发 hello 带 token，否则所有方法返回 unauthorized。",
    "jsonrpc": "兼容 JSON-RPC 2.0：请求带 \"jsonrpc\":\"2.0\" 时响应也带。"
  },
  "request_example": {"id": 7, "method": "arm.state", "params": {"arm": "koch_v1_1:follower"}},
  "response_example": {"id": 7, "result": {"seq": 123, "connected": true, "joints": {"1": 1511}, "deg": {"shoulder_pan": 43.24}}},
  "error_example": {"id": 7, "error": {"code": "no_such_arm", "message": "unknown arm 'x'"}},
  "errors": [
    {"code": "bad_request", "meaning": "参数缺失/类型错误/校验失败"},
    {"code": "no_such_arm", "meaning": "arm id 不存在（可用 arm.list 查询）"},
    {"code": "no_such_sub", "meaning": "订阅 id 不存在"},
    {"code": "unknown_method", "meaning": "未知方法"},
    {"code": "queue_full", "meaning": "urgent/normal 队列满，客户端应退避重试"},
    {"code": "timeout", "meaning": "worker 未在期限内回复（总线可能卡住）"},
    {"code": "serial_error", "meaning": "串口/舵机错误（含舵机硬件 error 位）"},
    {"code": "io_error", "meaning": "本地文件读写失败（如 profile 写入）"},
    {"code": "unauthorized", "meaning": "已配置 token，但连接未先 hello"},
    {"code": "closed", "meaning": "客户端已关闭（客户端侧错误）"}
  ],
  "methods": [
    {"name": "ping", "params": [], "result": {"pong": "bool", "version": "str", "uptime_sec": "int"}, "desc": "健康检查。"},
    {"name": "hello", "params": [{"name": "token", "type": "str", "optional": true}], "result": {"ok": "bool", "auth_required": "bool", "version": "str"}, "desc": "鉴权握手（配置了 token 时必需）。"},
    {"name": "info", "params": [], "result": {"version": "str", "uptime_sec": "int", "socket": "str", "arms": "[str]"}, "desc": "守护进程信息。"},
    {"name": "arm.list", "params": [], "result": {"[arm]": "见 arm.state"}, "desc": "所有机械臂摘要：id/label/port/sim/motors/connected/hz/seq/error/profile_saved_at/stats。"},
    {"name": "arm.state", "params": [{"name": "arm", "type": "str"}], "result": {"seq": "int", "ts": "int ms", "connected": "bool", "joints": "{motor_id: raw}", "deg": "{joint: deg}", "joint_names": "{motor_id: joint}", "health": "{motor_id: {voltage, temp}}", "hz": "float", "read_us": "int", "error": "str|null", "profile_saved_at": "int|null"}, "desc": "读状态缓存，不占总线。deg 只在有 profile 时出现。"},
    {"name": "arm.read", "params": [{"name": "arm", "type": "str"}, {"name": "motors", "type": "[u8]", "optional": true}, {"name": "timeout_ms", "type": "int", "optional": true, "default": 50}], "result": {"positions": "{motor_id: raw}"}, "desc": "立刻 sync_read 一次（占用总线），用于即时取值/标定采点。"},
    {"name": "arm.read_register", "params": [{"name": "arm", "type": "str"}, {"name": "motor", "type": "u8"}, {"name": "address", "type": "u16"}, {"name": "length", "type": "u16"}], "result": {"data": "[u8]", "value": "int"}, "desc": "读任意控制表寄存器（小端有符号解析）。"},
    {"name": "arm.write_register", "params": [{"name": "arm", "type": "str"}, {"name": "motor", "type": "u8"}, {"name": "address", "type": "u16"}, {"name": "length", "type": "u16"}, {"name": "value", "type": "int"}], "result": {"ok": "bool"}, "desc": "写任意寄存器（等舵机状态包确认）。"},
    {"name": "arm.sync_write", "params": [{"name": "arm", "type": "str"}, {"name": "address", "type": "u16"}, {"name": "length", "type": "u16"}, {"name": "values", "type": "{motor_id: value}"}], "result": {"ok": "bool"}, "desc": "同步写多个舵机（广播式，不等回包）。"},
    {"name": "arm.torque", "params": [{"name": "arm", "type": "str"}, {"name": "enable", "type": "bool"}, {"name": "motors", "type": "[u8]", "optional": true}], "result": {"ok": "bool"}, "desc": "扭矩开关（写 Torque_Enable=64）。"},
    {"name": "arm.ping", "params": [{"name": "arm", "type": "str"}, {"name": "motor", "type": "u8"}], "result": {"model": "int"}, "desc": "单舵机 ping，返回 model number。"},
    {"name": "arm.set_rate", "params": [{"name": "arm", "type": "str"}, {"name": "hz", "type": "float (0.5~500)"}], "result": {"ok": "bool", "hz": "float"}, "desc": "改轮询频率。"},
    {"name": "arm.reconnect", "params": [{"name": "arm", "type": "str"}], "result": {"ok": "bool"}, "desc": "强制重开串口（排查用）。"},
    {"name": "arm.stats", "params": [{"name": "arm", "type": "str"}], "result": {"polls": "int", "read_errors": "int", "writes": "int", "frames_published": "int", "frames_dropped": "int", "reconnects": "int", "urgent_queued": "int", "normal_queued": "int"}, "desc": "计数器。"},
    {"name": "arm.profile.get", "params": [{"name": "arm", "type": "str"}], "result": {"profile": "profile|null", "path": "str", "has_profile": "bool"}, "desc": "读取标定档案。"},
    {"name": "arm.profile.set", "params": [{"name": "arm", "type": "str"}, {"name": "profile", "type": "profile"}], "result": {"profile": "profile", "path": "str"}, "desc": "校验并持久化档案（覆盖前自动留历史快照）。"},
    {"name": "arm.profile.history", "params": [{"name": "arm", "type": "str"}], "result": {"history": "[{name, savedAt}]", "dir": "str"}, "desc": "历史快照列表（保留最近 20 份）。"},
    {"name": "arm.profile.restore", "params": [{"name": "arm", "type": "str"}, {"name": "name", "type": "str"}], "result": {"restored": "str", "profile": "profile"}, "desc": "从历史快照恢复。"},
    {"name": "arm.profile.delete", "params": [{"name": "arm", "type": "str"}], "result": {"deleted": "bool"}, "desc": "删除档案。"},
    {"name": "arm.calibration.snapshot", "params": [{"name": "arm", "type": "str"}], "result": {"raw": "{joint: raw}", "deg": "{joint: deg}", "seq": "int", "ts": "int", "connected": "bool", "health": "{motor_id: {voltage, temp}}"}, "desc": "标定采点用：当前 raw（按关节名）+角度+健康，不占总线。"},
    {"name": "sub.subscribe", "params": [{"name": "arms", "type": "[str]", "optional": true}, {"name": "rate_hz", "type": "float", "optional": true, "default": 60}], "result": {"sub_id": "int", "rate_hz": "float", "arms": "[str]"}, "desc": "订阅状态流。rate>=54 时直通每个轮询帧；更低频率按时间抽帧。"},
    {"name": "sub.unsubscribe", "params": [{"name": "sub_id", "type": "int"}], "result": {"ok": "bool"}, "desc": "退订。"},
    {"name": "sub.rate", "params": [{"name": "sub_id", "type": "int"}, {"name": "rate_hz", "type": "float"}], "result": {"ok": "bool"}, "desc": "改订阅频率。"}
  ],
  "events": [
    {"event": "state", "fields": {"event": "\"state\"", "sub": "int", "arm": "str", "seq": "int", "ts": "int ms", "connected": "bool", "hz": "float", "joints": "{motor_id: raw}", "deg": "{joint: deg}", "health": "{motor_id: {voltage, temp}}"}, "desc": "周期状态帧。"},
    {"event": "arm", "fields": {"event": "\"arm\"", "sub": "int", "arm": "str", "connected": "bool", "error": "str|null", "ts": "int ms"}, "desc": "连接状态变化事件（掉线/恢复）。"}
  ],
  "profile_schema": {
    "description": "标定档案：raw→URDF 关节角的换算参数。存在 ~/.config/armd/profiles/<arm-id>.json。",
    "fields": {
      "zero": "{joint: raw}", "sign": "{joint: 1|-1}",
      "grip": {"open": "int", "closed": "int", "angle": "float (5~140.5, 可选)"},
      "spin": {"wrist_roll": "float (-180~180, 可选)"},
      "savedAt": "int (unix 秒)"
    },
    "formula": "非夹爪关节：deg = wrap(raw - zero) % 4096（折到 ±2048）× 360/4096 × sign；夹爪：deg = clamp((raw - closed)/(open - closed), 0, 1) × (angle 或 137.5)"
  },
  "config_fields": [
    {"key": "socket", "default": "/tmp/armd.sock", "desc": "兼容字段：未配 listen 时等价 listen=[unix:<socket>]"},
    {"key": "listen", "default": "[]", "desc": "监听地址数组：unix:<path> / tcp://host:port"},
    {"key": "token", "default": "null", "desc": "可选访问令牌"},
    {"key": "identity", "default": "/tmp/armd-identity.json 或 /run/armd/identity.json", "desc": "身份文件路径"},
    {"key": "arms[].id", "desc": "对外 arm id，建议 <robot>:<role>"},
    {"key": "arms[].port", "desc": "串口设备路径（sim=true 可空）"},
    {"key": "arms[].baud", "default": 1000000, "desc": "波特率"},
    {"key": "arms[].poll_hz", "default": 60, "desc": "轮询频率"},
    {"key": "arms[].motors", "default": "[1,2,3,4,5,6]", "desc": "轮询的舵机 id"},
    {"key": "arms[].monitor", "default": false, "desc": "每秒读电压/温度（寄存器 144/146）"},
    {"key": "arms[].joint_names", "default": "{}", "desc": "舵机 id→关节名，标定档案与角度换算必需"},
    {"key": "arms[].profile", "default": "~/.config/armd/profiles/<arm-id>.json", "desc": "标定档案路径"},
    {"key": "arms[].sim", "default": false, "desc": "仿真臂"},
    {"key": "arms[].reconnect_sec", "default": 2.0, "desc": "断线重连间隔"},
    {"key": "arms[].read_timeout_ms", "default": 30, "desc": "单次 sync_read 超时"}
  ],
  "packages": {
    "repo": "Gogs adam/armd, GitHub ColdZoo/armd, 本地 /raid/Projects/armd",
    "python_client": "clients/python/armd_client.py（纯标准库）",
    "cli": "python3 clients/python/armd_client.py --socket /tmp/armd.sock <info|arms|state|read|stats|watch|torque|write|profile|snapshot>"
  }
}
